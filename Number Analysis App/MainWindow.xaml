<Window x:Class="Number_Analysis_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Number_Analysis_App"
        mc:Ignorable="d"
        Title="Number Analysis App" Height="450" Width="800">
    <Viewbox>
        <Grid Width="1074" Height="580">
            <Grid.Background >
                <ImageBrush ImageSource="/number.jpg"/>
                
                
            </Grid.Background>


            <TextBox x:Name="EnterNumberBox" HorizontalAlignment="Left" Margin="210,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" AutomationProperties.HelpText="Enter the number here" Height="18"/>
            <Button x:Name="button" Content="Analyze" HorizontalAlignment="Left" Margin="375,469,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.222,-2.754" Click="button_Click" Height="20" Width="45"/>
            <TextBox x:Name="ShowNumberBox" HorizontalAlignment="Left" Margin="210,112,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.354,0.169" TextWrapping="WrapWithOverflow" IsReadOnly="True" Height="18"/>
            <Label x:Name="label" Content="Entered Number" HorizontalAlignment="Left" Margin="80,108,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="98"/>
            <Label x:Name="label1" Content="Enter a number here ->" HorizontalAlignment="Left" Margin="43,67,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="135"/>
            <TextBox x:Name="ShowDigitsOfNumberBox" HorizontalAlignment="Left" Margin="210,167,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.354,0.169" TextWrapping="WrapWithOverflow" IsReadOnly="True" Height="18"/>
            <Label x:Name="label_Copy" Content="Amount of digits" HorizontalAlignment="Left" Margin="80,163,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="99"/>
            <TextBox x:Name="SumOfDigitsBox" HorizontalAlignment="Left" Margin="210,231,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.354,0.169" TextWrapping="WrapWithOverflow" IsReadOnly="True" Height="18"/>
            <Label x:Name="label_Copy1" Content="Sum of digits" HorizontalAlignment="Left" Margin="80,227,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="80"/>
            <TextBox x:Name="ProductOfDigitsBox" HorizontalAlignment="Left" Margin="210,288,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.354,0.169" TextWrapping="WrapWithOverflow" IsReadOnly="True" Height="18"/>
            <Label x:Name="label_Copy2" Content="Product of Digits" HorizontalAlignment="Left" Margin="80,284,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="99"/>
            <Label x:Name="label2" Content="Binary Representation" HorizontalAlignment="Left" Margin="80,334,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="126"/>
            <TextBox x:Name="BinaryTextBox" HorizontalAlignment="Left" Margin="225,338,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True" Height="18"/>
            <Label x:Name="label2_Copy" Content="Octal Representation" HorizontalAlignment="Left" Margin="550,65,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="126"/>
            <TextBox x:Name="OctalTextBox" HorizontalAlignment="Left" Margin="725,69,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True" Height="18"/>
            <Label x:Name="label2_Copy1" Content="HexaDecimal Representation" HorizontalAlignment="Left" Margin="538,110,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Height="26" Width="162"/>
            <TextBox x:Name="HexaDecimalTextBox" HorizontalAlignment="Left" Margin="725,114,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True" Height="18"/>
            <Label x:Name="label3" Content="Is the Prime Number?" HorizontalAlignment="Left" Margin="538,165,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Width="128"/>
            <TextBox x:Name="PrimeNumberBox" HorizontalAlignment="Left" Margin="725,165,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True" RenderTransformOrigin="0.5,0.448"/>
            <Label x:Name="label4" Content="Is the Palindrome?" HorizontalAlignment="Left" Margin="548,207,0,0" VerticalAlignment="Top" Background="WhiteSmoke"/>
            <TextBox x:Name="PalindromeTextBox" HorizontalAlignment="Left" Margin="725,207,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
            <Label x:Name="label5" Content="Is the Amstrong Number?" HorizontalAlignment="Left" Margin="550,251,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Width="150"/>
            <TextBox x:Name="AmstrongTextBox" HorizontalAlignment="Left" Margin="725,251,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
            <Label x:Name="label6" Content="Max Digit" HorizontalAlignment="Left" Margin="571,295,0,0" VerticalAlignment="Top" Background="WhiteSmoke"/>
            <TextBox x:Name="MaxDigitBox" HorizontalAlignment="Left" Margin="725,299,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
            <Label x:Name="label7" Content="Min Digit" HorizontalAlignment="Left" Margin="570,336,0,0" VerticalAlignment="Top" Background="WhiteSmoke"/>
            <TextBox x:Name="MinDigitBox" HorizontalAlignment="Left" Margin="725,336,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
            <Label x:Name="label8" Content="Is the Perfect Number?" HorizontalAlignment="Left" Margin="80,378,0,0" VerticalAlignment="Top" Background="WhiteSmoke"/>
            <TextBox x:Name="PerfectNumberBox" HorizontalAlignment="Left" Margin="225,382,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
            <Label x:Name="label9" Content="Contains Even Digits?" HorizontalAlignment="Left" Margin="560,376,0,0" VerticalAlignment="Top" Background="WhiteSmoke" Width="125"/>
            <TextBox x:Name="EvenDigitsBox" HorizontalAlignment="Left" Margin="725,376,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
            <Label x:Name="label10" Content="Contains Odd Digits" HorizontalAlignment="Left" Margin="80,418,0,0" VerticalAlignment="Top" Background="WhiteSmoke"/>
            <TextBox x:Name="OddDigitsBox" HorizontalAlignment="Left" Margin="225,422,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True"/>
            <Label x:Name="label11" Content="Is the number factorial?" Background="WhiteSmoke" HorizontalAlignment="Left" Margin="531,18,0,0" VerticalAlignment="Top" Width="147"/>
            <TextBox x:Name="IsFactorialTextBox" HorizontalAlignment="Left" Margin="712,26,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" IsReadOnly="True" Height="18"/>
            <Label x:Name="label12" Content="Is the strong number?" Background="WhiteSmoke" HorizontalAlignment="Left" Margin="564,412,0,0" VerticalAlignment="Top" Width="136"/>
            <TextBox x:Name="IsStrongNumberTextBox" HorizontalAlignment="Left" Margin="725,416,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
            <Button x:Name="button1" Content="Generate Report" HorizontalAlignment="Left" Margin="462,469,0,0" VerticalAlignment="Top" Click="button1_Click"/>



        </Grid>
    </Viewbox>
</Window>
